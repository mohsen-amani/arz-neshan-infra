# Public application URLs. Domains are assigned to services in Coolify.
FRONT_APP_URL=https://admin.example.com
CLIENT_APP_URL=https://app.example.com
ADMIN_BASE_DOMAIN=admin.example.com
CLIENT_BASE_DOMAIN=app.example.com
PUBLIC_APP_URL=https://admin.example.com
CORS_ORIGINS=https://admin.example.com,https://app.example.com

# External PostgreSQL connection.
DATABASE_HOST=postgres.internal
DATABASE_PORT=5432
DATABASE_USER=arz_neshan
DATABASE_PASS=replace-with-a-long-random-password
DATABASE_NAME=arz_neshan

# Application and authentication.
APP_NAME=Arz Neshan
FRONT_RESET_PASSWORD_PATH=/auth/reset-password
TRUST_PROXY_HOPS=2
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_AUDIENCE=arz-neshan-api
JWT_ISSUER=arz-neshan
JWT_ACCESS_TOKEN_TTL=15m
AUTH_SESSION_TTL=30d
AUTH_COOKIE_SECURE=true
RESET_PASSWORD_TOKEN_TTL=15m
RESET_PASSWORD_OTP_PEPPER=replace-with-a-separate-long-random-value
RATE_LIMIT_WINDOW=1m
RATE_LIMIT_MAX_REQUESTS=100

# Signup, billing, and authenticated internal jobs.
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret
SMS_GATEWAY_URL=https://sms-gateway.example.com
SMS_GATEWAY_KEY_ID=arz-neshan-api
SMS_GATEWAY_SECRET=replace-with-shared-hmac-secret
INTERNAL_JOBS_TOKEN=replace-with-a-long-random-token
HESABPAY_API_URL=https://api.hesab.com
HESABPAY_API_KEY=replace-with-hesabpay-api-key

# Optional first-boot platform owner. Remove these after the account exists.
PLATFORM_OWNER_EMAIL=owner@example.com
PLATFORM_OWNER_PASSWORD=replace-with-a-strong-password
PLATFORM_OWNER_TOTP_SECRET=replace-with-a-base32-totp-secret

# External SMTP.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=no-reply@example.com
MAIL_PASS=replace-with-the-smtp-password
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_TLS_SERVERNAME=smtp.example.com
MAIL_FROM=Arz Neshan <no-reply@example.com>
MAIL_SUPPORT=support@example.com

# Attachment storage. S3 is preferred for durable multi-node production.
ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_MAX_BYTES=10485760
CLAMAV_TIMEOUT_MS=15000
ATTACHMENT_S3_ENDPOINT=
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_BUCKET=
ATTACHMENT_S3_ACCESS_KEY_ID=
ATTACHMENT_S3_SECRET_ACCESS_KEY=
ATTACHMENT_S3_FORCE_PATH_STYLE=true
ATTACHMENT_S3_CA_CERT=

# External HTTPS Vault Transit.
VAULT_ADDR=https://vault.example.com
VAULT_NAMESPACE=
VAULT_TOKEN=replace-with-a-least-privilege-vault-token
VAULT_TRANSIT_MOUNT=transit
VAULT_TRANSIT_KEY=arz-neshan-attachments
VAULT_CA_CERT=
VAULT_TIMEOUT_MS=5000

# Optional pinned ClamAV image override.
CLAMAV_IMAGE=clamav/clamav:1.4.5_base
